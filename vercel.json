{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/review/(.*)",
      "dest": "/client-review.html"
    },
    {
      "src": "/(.*\\.(html|js|css|json|md|png|jpg|svg|ico|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/benchmark.js": {
      "maxDuration": 300
    }
  }
}
